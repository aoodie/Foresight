# Copy this file to .env.autotrader and replace every placeholder.
# Keep AUTOTRADER_ENABLED=false until Practice configuration is verified.
AUTOTRADER_ENABLED=false
OANDA_ENVIRONMENT=practice
OANDA_TOKEN=replace-with-oanda-practice-token
OANDA_ACCOUNT_ID=replace-with-oanda-practice-account-number

# Only these explicitly listed instruments can be traded by the worker.
AUTOTRADER_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
TRADING_STYLE=intraday

# Position sizing and hard limits.
RISK_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2
MAX_TRADES_PER_DAY=5
MAX_OPEN_TRADES=2
MAX_OPEN_TRADES_PER_INSTRUMENT=1
MAX_SPREAD_PIPS=2.5
MAX_UNITS=1000000
# Keep the first risk-safe size fixed per instrument for the UTC day.
# Use weekly for a Monday-Sunday lock, or none for fully dynamic sizing.
AUTOTRADER_SIZE_LOCK_SCOPE=daily

# Worker timing. The LLM is event-driven and cached, never called every tick.
AUTOTRADER_POLL_MS=5000
AUTOTRADER_SCAN_MS=60000
AUTOTRADER_HEARTBEAT_MS=60000
REQUIRE_TRIGGER_CONFIRMATION=true
LLM_API_KEY=
# Legacy name still works, but use LLM_API_KEY for the custom gateway.
# OPENAI_API_KEY=
# Leave blank for the gateway default, or set your custom gateway model ID.
LLM_MODEL=
LLM_BASE_URL=https://api.aoodie.xyz/v1
LLM_REVIEW_MS=900000
LLM_MOVE_ATR_FRACTION=0.25
AUTOTRADER_AUTOCLOSE_ON_LLM_CLOSE=false
# Review dashboard-opened trades continuously. Closing them requires both
# AUTOTRADER_AUTOCLOSE_ON_LLM_CLOSE and the separate permission below.
AUTOTRADER_MONITOR_DASHBOARD_TRADES=true
AUTOTRADER_AUTOCLOSE_DASHBOARD_TRADES=false
AUTOTRADER_CLOSE_UNPROTECTED=true

# Durable worker files.
AUTOTRADER_DATABASE_PATH=./data/autotrader.sqlite
AUTOTRADER_LOCK_PATH=./data/autotrader.lock

# Optional sync back to the hosted dashboard journal and system logs.
AUTOTRADER_DASHBOARD_URL=https://foresight.aoodie.xyz
AUTOTRADER_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

# Live trading requires both explicit values below in addition to OANDA_ENVIRONMENT=live.
# AUTOTRADER_ALLOW_LIVE=true
# AUTOTRADER_LIVE_CONFIRM=I_UNDERSTAND_LIVE_RISK
